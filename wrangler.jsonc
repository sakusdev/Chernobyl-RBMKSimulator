{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chernobyl-rbmk-simulator",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-28",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
